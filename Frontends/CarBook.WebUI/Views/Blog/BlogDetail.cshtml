
@{
    ViewData["Title"] = "BlogDetail";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section ftco-degree-bg">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("_BlogDetailMainComponentPartials", new { id = ViewBag.blogid })
            <div class="col-md-4 sidebar ftco-animate">
                @await Component.InvokeAsync("_BlogDetailSideBarSearchBoxComponentPartials")
                @await Component.InvokeAsync("_BlogDetailCategoryViewComponentPartials", new { id = ViewBag.blogid })
                @await Component.InvokeAsync("_BlogDetailRecentBlogComponentPartials", new { id = ViewBag.blogid })
                @await Component.InvokeAsync("_BlogDetailTagCloudComponentPartials", new { id = ViewBag.blogid })  
                @await Component.InvokeAsync("_BlogDetailParagraphComponentPartials")


            </div>

        </div>
    </div>
</section>

