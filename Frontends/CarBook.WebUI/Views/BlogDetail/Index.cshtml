@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<section class="ftco-section ftco-degree-bg">
    <div class="container">
        <div class="row">
            @await Component.InvokeAsync("_BlogDetailMainComponentPartials")
            <div class="col-md-4 sidebar ftco-animate">
                @await Component.InvokeAsync("_BlogDetailSideBarSearchBoxComponentPartials")
                @await Component.InvokeAsync("_BlogDetailCategoryViewComponentPartials")
                @await Component.InvokeAsync("_BlogDetailRecentBlogComponentPartials")
                @await Component.InvokeAsync("_BlogDetailTagCloudComponentPartials")
                @await Component.InvokeAsync("_BlogDetailParagraphComponentPartials")

      
            </div>

        </div>
    </div>
</section>